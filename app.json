{
  "expo": {
    "name": "아기기록",
    "slug": "baby_check",
    "version": "1.7.1",
    "scheme": "babycheck",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "runtimeVersion": "1.3.0",
    "updates": {
      "enabled": false,
      "url": "https://u.expo.dev/79563103-adf4-45c2-b610-ae4c461868f0",
      "checkAutomatically": "NEVER",
      "requestHeaders": {
        "expo-channel-name": "master"
      }
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.seonggi.babycheck",
      "buildNumber": "1",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.seonggi.babycheck",
      "versionCode": 19,
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "79563103-adf4-45c2-b610-ae4c461868f0"
      }
    },
    "owner": "seonggi",
    "plugins": [
      "./plugins/withBabyStatusWidget",
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "음성 기록을 위해 마이크를 사용합니다.",
          "speechRecognitionPermission": "말한 내용을 수유와 수면 기록으로 입력하기 위해 음성을 인식합니다."
        }
      ],
      "./plugins/withOptionalMicrophone",
      "expo-notifications",
      [
        "expo-widgets",
        {
          "widgets": [
            {
              "name": "FeedingReminderWidget",
              "displayName": "다음 수유",
              "description": "마지막 수유와 다음 수유 예정 시간을 보여줍니다.",
              "ios": {
                "supportedFamilies": [
                  "systemSmall",
                  "systemMedium",
                  "systemLarge",
                  "accessoryRectangular",
                  "accessoryInline"
                ]
              }
            }
          ]
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#FDFBF7",
          "imageWidth": 200
        }
      ],
      "expo-sharing"
    ]
  }
}
